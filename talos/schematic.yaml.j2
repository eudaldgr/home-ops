---
customization:
  extraKernelArgs:
    - i915.enable_guc=2 # Intel iGPU HuC firmware (Gen9-10 QuickSync)
    - intel_iommu=on # PCI Passthrough
    - iommu=pt # PCI Passthrough
  systemExtensions:
    officialExtensions:
      - siderolabs/drbd # Miroir DRBD9 Replication
      - siderolabs/gvisor # Sandboxed Containers
      - siderolabs/i915 # Intel iGPU
      - siderolabs/intel-ucode # Intel iGPU
      - siderolabs/mei # Intel iGPU
      - siderolabs/nfsrahead # NFS Readahead
      - siderolabs/realtek-firmware # Realtek RTL8125B NICs (k8s-0, k8s-2)
